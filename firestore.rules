rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 認証チェックを削除し、基本的に誰でもアクセス可能に
    // （プロダクション環境では適切な認証を追加することを推奨）
    
    // rooms コレクション: 誰でも読み書き可能
    match /rooms/{roomId} {
      allow read, write: if true;

      // すべてのサブコレクションも誰でもアクセス可能
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // デフォルト allow（開発用）
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
