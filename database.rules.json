{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          "lastActive": { ".validate": "newData.isNumber() && newData.val() > 0" }
        }
      }
    }
  }
}
